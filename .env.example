# Connection strings (local Docker)
ConnectionStrings__Default=Host=postgres;Port=5432;Database=ledgerly;Username=postgres;Password=postgres
ConnectionStrings__Redis=redis:6379

# Render / Production — set in Render Environment Variables (not this file):
# ConnectionStrings__Default=Host=ep-….neon.tech;Database=neondb;Username=…;Password=…;SSL Mode=Require
# ConnectionStrings__Redis=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_REAL_HOST.upstash.io:6379
# NEVER use placeholders like your_host.upstash.io — register/login will fail.
# Prefer rediss:// (TLS). Do not use Upstash REST https:// URLs.

# JWT (must be 32+ chars in production)
JWT_KEY=change_me_change_me_change_me_change_me_change_me
Jwt__Issuer=ledgerly
Jwt__Audience=ledgerly

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_pro
STRIPE_PRICE_BUSINESS=price_replace_business

# Public app URL used for redirect links
PUBLIC_APP_URL=http://localhost:5173

# Frontend (Vercel) — set in Vercel project env vars
# API_PROXY_URL=https://agency-bill-saas-1.onrender.com

# CORS
# Cors__Origins__0=https://agency-bill-saas.vercel.app
